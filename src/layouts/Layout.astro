---
import { identity } from "../config";
import type { SEOInfo } from "../config";

interface Props {
  seo: SEOInfo;
}

const { seo } = Astro.props;
const siteURL = Astro.site ?? new URL("https://haris.ezwin.academy");
const canonicalURL = new URL(Astro.url.pathname, siteURL);
const imageURL = new URL(seo.image, siteURL);
const imageExtension = imageURL.pathname.split(".").at(-1)?.toLowerCase();
const imageType =
  imageExtension === "jpg" || imageExtension === "jpeg"
    ? "image/jpeg"
    : imageExtension === "webp"
      ? "image/webp"
      : "image/png";
const personID = new URL("/#haris-samingan", siteURL).href;
const websiteID = new URL("/#website", siteURL).href;
const isArticle = seo.type === "article";

const person = {
  "@type": "Person",
  "@id": personID,
  name: identity.name,
  alternateName: `@${identity.handle}`,
  url: new URL("/", siteURL).href,
  image: new URL(identity.photo, siteURL).href,
  jobTitle: identity.role,
  description:
    "Singapore founder and educator writing about AI, education, tuition, and building education businesses.",
  homeLocation: {
    "@type": "Place",
    name: identity.location,
  },
  sameAs: [identity.linkedin],
};

const structuredData = isArticle
  ? {
      "@context": "https://schema.org",
      "@type": "BlogPosting",
      "@id": `${canonicalURL.href}#article`,
      mainEntityOfPage: canonicalURL.href,
      headline: seo.title.replace(` — ${identity.name}`, ""),
      description: seo.description,
      image: imageURL.href,
      datePublished: seo.publishedTime,
      dateModified: seo.publishedTime,
      author: person,
      isPartOf: {
        "@type": "WebSite",
        "@id": websiteID,
        name: identity.name,
        url: new URL("/", siteURL).href,
      },
    }
  : {
      "@context": "https://schema.org",
      "@graph": [
        {
          "@type": "WebSite",
          "@id": websiteID,
          name: identity.name,
          alternateName: `${identity.name}'s writing`,
          url: new URL("/", siteURL).href,
          description: seo.description,
          inLanguage: "en",
          publisher: { "@id": personID },
        },
        {
          "@type": "ProfilePage",
          "@id": `${canonicalURL.href}#profile-page`,
          url: canonicalURL.href,
          name: seo.title,
          description: seo.description,
          mainEntity: person,
          isPartOf: { "@id": websiteID },
        },
      ],
    };

const jsonLD = JSON.stringify(structuredData).replace(/</g, "\\u003c");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#100f0a" />
    <meta name="generator" content={Astro.generator} />
    <meta name="author" content={identity.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonicalURL} />
    <meta property="og:type" content={seo.type ?? "website"} />
    <meta property="og:site_name" content={identity.name} />
    <meta property="og:locale" content="en_SG" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:secure_url" content={imageURL} />
    <meta property="og:image:type" content={imageType} />
    <meta property="og:image:width" content="1232" />
    <meta property="og:image:height" content="928" />
    <meta property="og:image:alt" content={seo.imageAlt ?? seo.title} />
    {seo.publishedTime && (
      <meta property="article:published_time" content={seo.publishedTime} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={seo.title} />
    <meta name="twitter:description" content={seo.description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={seo.imageAlt ?? seo.title} />
    <script type="application/ld+json" set:html={jsonLD} is:inline />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="page-shell">
      <slot />

      <footer class="site-footer">
        <span>© 2026 {identity.name}</span>
        <span>Made in {identity.location} {identity.flag}</span>
      </footer>
    </div>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;

    /* Ledger — the site's mono/hairline palette. */
    --led-page: #100f0a;
    --led-card: #16150f;
    --led-edge: #2e2c25;
    --led-rule: #2a2822;
    --led-head: #f4f1e7;
    --led-bright: #efece2;
    --led-body: #cfcbbe;
    --led-quote: #9b9788;
    --led-muted: #8a8778;
    --led-faint: #6a6759;
    --led-quote-rule: #3a3830;
    --led-mono: "IBM Plex Mono", ui-monospace, monospace;
    --led-sans: "IBM Plex Sans", Helvetica, Arial, sans-serif;
  }

  * {
    box-sizing: border-box;
  }

  html {
    min-width: 320px;
    background: var(--led-page);
  }

  body {
    margin: 0;
    background: var(--led-page);
    color: var(--led-body);
    font-family: var(--led-sans);
    -webkit-font-smoothing: antialiased;
  }

  a {
    color: inherit;
    text-underline-offset: 3px;
  }

  img {
    max-width: 100%;
  }

  .page-shell {
    min-height: 100vh;
  }

  .ledger-card {
    width: min(calc(100% - 32px), 880px);
    margin: 40px auto 0;
    background: var(--led-card);
    border: 1px solid var(--led-edge);
  }

  .site-footer {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    width: min(calc(100% - 32px), 880px);
    margin: 40px auto 0;
    padding: 18px 0 56px;
    border-top: 1px solid var(--led-rule);
    color: var(--led-faint);
    font-family: var(--led-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
  }

  @media (max-width: 540px) {
    .site-footer {
      width: calc(100% - 32px);
      padding-bottom: 36px;
    }
  }
</style>
