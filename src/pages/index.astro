---
import Layout from "../layouts/Layout.astro";
import { getCollection, type CollectionEntry } from "astro:content";
import { siteContent } from "../config";
import { monthDay, tagOf } from "../lib/ledger";

const posts = await getCollection("posts");
posts.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);

// Newest first, then bucketed under a year heading.
const years: { year: number; entries: CollectionEntry<"posts">[] }[] = [];
for (const post of posts) {
  const year = new Date(post.data.pubDate).getFullYear();
  const current = years.at(-1);
  if (current?.year === year) current.entries.push(post);
  else years.push({ year, entries: [post] });
}
---

<Layout seo={siteContent.seo}>
  <main class="ledger-card">
    <header class="masthead">
      <img
        class="masthead-photo"
        src="/haris-teaching.webp"
        alt="Portrait of Haris Samingan"
        width="720"
        height="720"
        decoding="async"
      />
      <div class="masthead-copy">
        <h1 class="masthead-name">{siteContent.masthead}</h1>
        <p class="masthead-tagline">
          {siteContent.tagline.beforeLink}<a
            href={siteContent.tagline.linkUrl}
            target="_blank"
            rel="noopener noreferrer"
            >{siteContent.tagline.linkText}</a
          >{siteContent.tagline.afterLink}
        </p>
      </div>
    </header>

    <div class="ledger-body">
      {
        years.map(({ year, entries }) => (
          <Fragment>
            <div class="year-label">{year}</div>
            <div class="year-rows">
              {entries.map((post) => (
                <a class="row" href={`/blog/${post.id}`}>
                  <span class="row-date" data-tag={tagOf(post.data.eyebrow)}>
                    {monthDay(new Date(post.data.pubDate))}
                  </span>
                  <span class="row-title">{post.data.title}</span>
                  <span class="row-tag">{tagOf(post.data.eyebrow)}</span>
                </a>
              ))}
            </div>
          </Fragment>
        ))
      }
    </div>
  </main>
</Layout>

<style>
  .masthead {
    padding: 16px 72px 20px 24px;
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr);
    gap: 24px;
    align-items: center;
    border-bottom: 1px solid var(--led-rule);
  }

  .masthead-copy {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .masthead-name {
    margin: 0;
    font-family: var(--led-mono);
    font-weight: 400;
    font-size: 26px;
    letter-spacing: -0.01em;
    color: var(--led-bright);
  }

  .masthead-tagline {
    margin: 0;
    max-width: 68ch;
    font-family: var(--led-mono);
    font-size: 13px;
    line-height: 1.7;
    color: var(--led-muted);
  }

  .masthead-photo {
    display: block;
    width: 120px;
    height: 120px;
    object-fit: cover;
    object-position: center;
    border: 1px solid var(--led-rule);
  }

  .ledger-body {
    padding: 8px 72px 56px;
  }

  .year-label {
    padding: 34px 0 10px;
    font-family: var(--led-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--led-faint);
  }

  .year-label:first-child {
    padding-top: 22px;
  }

  .row {
    display: grid;
    grid-template-columns: 76px 1fr 92px;
    gap: 24px;
    align-items: baseline;
    padding: 15px 0;
    border-top: 1px solid var(--led-rule);
    font-family: var(--led-mono);
    text-decoration: none;
  }

  .ledger-body > .year-rows:last-child .row:last-child {
    border-bottom: 1px solid var(--led-rule);
  }

  .row-date,
  .row-tag {
    font-size: 12px;
    color: var(--led-faint);
  }

  .row-tag {
    font-size: 11px;
    text-align: right;
  }

  .row-title {
    font-size: 17px;
    color: var(--led-bright);
    text-wrap: pretty;
  }

  .row:hover .row-title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .masthead {
      grid-template-columns: 72px minmax(0, 1fr);
      gap: 16px;
      padding: 16px 24px 18px;
    }

    .masthead-name {
      font-size: 20px;
    }

    .masthead-tagline {
      font-size: 12px;
      line-height: 1.65;
    }

    .masthead-photo {
      width: 72px;
      height: 72px;
    }

    .ledger-body {
      padding: 0 24px 40px;
    }

    .row {
      grid-template-columns: 1fr;
      gap: 5px;
      padding: 14px 0;
    }

    .row-date::after {
      content: " · " attr(data-tag);
    }

    .row-tag {
      display: none;
    }

    .row-date {
      font-size: 11px;
    }

    .row-title {
      font-size: 15px;
      line-height: 1.45;
    }
  }
</style>
