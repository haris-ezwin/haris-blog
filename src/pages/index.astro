---
import Layout from "../layouts/Layout.astro";
import { getCollection } from "astro:content";
import { siteContent } from "../config";
import { firstMarkdownImage, tagOf } from "../lib/ledger";

const posts = await getCollection("posts");
posts.sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime());
const coverDate = (date: Date) => new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
}).format(date).replace("Sept", "Sep");
---

<Layout seo={siteContent.seo}>
  <main class="journal">
    <header class="masthead">
      <a class="identity" href="/" aria-label="Haris Samingan home">
        <img src="/haris-teaching.webp" alt="Portrait of Haris Samingan" width="64" height="64" />
        <h1>{siteContent.masthead}</h1>
      </a>
      <p>{siteContent.tagline.beforeLink}<a href={siteContent.tagline.linkUrl} target="_blank" rel="noopener noreferrer">{siteContent.tagline.linkText}</a>{siteContent.tagline.afterLink}</p>
    </header>
    <section aria-label="Latest writing" class="post-grid">
      {posts.map((post, index) => {
        const cover = firstMarkdownImage(post.body);
        return (
          <a class="post-card" href={`/blog/${post.id}`}>
            <div class:list={["cover", `cover-${index % 4}`, { "type-cover": !cover }]}>
              {cover ? <img src={cover.src} alt={cover.alt} loading={index < 4 ? "eager" : "lazy"} decoding="async" /> : <div class="cover-type" aria-hidden="true"><span class="cover-number">Notes / {String(posts.length - index).padStart(2, "0")}</span><span>{post.data.title}</span><span class="cover-signature">Haris Samingan ↗</span></div>}
              <span class="post-label">{tagOf(post.data.eyebrow)}<span aria-hidden="true"> · </span><time datetime={new Date(post.data.pubDate).toISOString()}>{coverDate(new Date(post.data.pubDate))}</time></span>
            </div>
            <h2>{post.data.title}</h2>
          </a>
        );
      })}
    </section>
  </main>
</Layout>

<style>
  .journal { width: min(calc(100% - 64px), 1440px); margin: 0 auto; }
  .masthead { display: flex; align-items: center; justify-content: space-between; gap: 40px; padding: 42px 0 38px; margin-bottom: 30px; border-bottom: 1px solid var(--led-rule); }
  .identity { display: flex; align-items: center; gap: 16px; text-decoration: none; flex-shrink: 0; }
  .identity img { width: 52px; height: 52px; border-radius: 50%; object-fit: cover; }
  h1 { margin: 0; font-size: 25px; font-weight: 600; letter-spacing: -.045em; color: var(--led-head); }
  .masthead p { max-width: 440px; margin: 0; font-size: 14px; line-height: 1.6; color: var(--led-muted); }
  .masthead p a { color: var(--led-head); }
  .post-grid { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 38px 20px; padding-bottom: 24px; }
  .post-card { min-width: 0; text-decoration: none; }
  .cover { position: relative; aspect-ratio: 4 / 5; overflow: hidden; border: 1px solid #d8d8d3; background: #e6e9e2; }
  .cover > img { display: block; width: 100%; height: 100%; object-fit: cover; transition: transform .35s ease; }
  .post-label { position: absolute; top: 12px; right: 12px; left: auto; max-width: calc(100% - 24px); display: flex; gap: 5px; align-items: center; padding: 8px 13px; border: 1px solid #7b7b7566; border-radius: 99px; background: #fafaf7f5; color: #30302e; font-size: 10px; line-height: 1.2; font-weight: 600; text-transform: uppercase; letter-spacing: .015em; }
  .post-label time { text-transform: none; white-space: nowrap; }
  h2 { margin: 12px 0 0; color: var(--led-head); font-size: 18px; line-height: 1.3; font-weight: 600; letter-spacing: -.035em; text-wrap: pretty; }
  .post-card:hover img { transform: scale(1.035); }
  .post-card:hover h2 { text-decoration: underline; text-underline-offset: 4px; }
  .post-card:focus-visible { outline: 2px solid #2866b7; outline-offset: 6px; }
  .cover-1 { background: #e1e7ee; }
  .cover-2 { background: #efe1cc; }
  .cover-3 { background: #e7dedf; }
  .cover-type { height: 100%; display: flex; flex-direction: column; justify-content: space-between; padding: 65px 24px 24px; color: #30392f; }
  .cover-type > span:nth-child(2) { font-size: clamp(23px, 2.5vw, 38px); line-height: 1.05; font-weight: 600; letter-spacing: -.055em; }
  .cover-number, .cover-signature { font-size: 11px; font-weight: 500; }
  @media (min-width: 1600px) { .cover-type > span:nth-child(2) { font-size: 42px; } }
  @media (max-width: 1000px) { .post-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); } .masthead { gap: 24px; } }
  @media (max-width: 760px) { .journal { width: calc(100% - 40px); } .masthead { align-items: flex-start; flex-direction: column; gap: 18px; padding: 28px 0; margin-bottom: 24px; } .post-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 28px 16px; } .cover-type { padding: 58px 16px 18px; } .cover-type > span:nth-child(2) { font-size: 28px; } h2 { font-size: 16px; } .post-label { top: 8px; right: 8px; max-width: calc(100% - 16px); padding: 7px 9px; font-size: 9px; } }
  @media (max-width: 420px) { .post-grid { grid-template-columns: 1fr; gap: 30px; } .cover-type > span:nth-child(2) { font-size: 42px; } h2 { font-size: 20px; } .post-label { font-size: 11px; top: 12px; right: 12px; padding: 8px 13px; } }
  @media (prefers-reduced-motion: reduce) { .cover > img { transition: none; } }
</style>
