---
import Layout from "../../layouts/Layout.astro";
import { getCollection, getEntry, render } from "astro:content";
import { identity, siteContent } from "../../config";
import { shortDate, tagOf } from "../../lib/ledger";

const { id } = Astro.params;
const entry = await getEntry("posts", id as string);

if (!entry) {
  return Astro.redirect("/");
}

const { Content } = await render(entry);

// Find the next (older) post for the "next" link.
const all = await getCollection("posts");
all.sort(
  (a, b) =>
    new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime(),
);
const idx = all.findIndex((p) => p.id === entry.id);
const next = idx >= 0 && idx < all.length - 1 ? all[idx + 1] : null;

const pub = new Date(entry.data.pubDate);
---

<Layout
  seo={{
    title: `${entry.data.title} — ${identity.name}`,
    description: entry.data.description,
    image: entry.data.socialImage ?? "/og-image.png",
    imageAlt:
      entry.data.socialImageAlt ??
      `${entry.data.title}, an article by ${identity.name}`,
    type: "article",
    publishedTime: pub.toISOString(),
  }}
>
  <main class="ledger-card">
    <div class="post-bar">
      <a class="post-back" href="/">← {siteContent.masthead}</a>
      <span>{shortDate(pub)} / {tagOf(entry.data.eyebrow)}</span>
    </div>

    <article class="post-body">
      <h1>{entry.data.title}</h1>
      <div class="prose"><Content /></div>
    </article>

    {
      next && (
        <div class="post-next">
          <div class="next-label">NEXT</div>
          <a class="next-title" href={`/blog/${next.id}`}>
            {next.data.title}
          </a>
        </div>
      )
    }
  </main>
</Layout>

<style>
  .post-bar {
    display: flex;
    justify-content: space-between;
    gap: 24px;
    padding: 28px 72px;
    border-bottom: 1px solid var(--led-rule);
    font-family: var(--led-mono);
    font-size: 12px;
    color: var(--led-faint);
  }

  .post-back {
    color: var(--led-muted);
    text-decoration: none;
  }

  .post-back:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .post-body {
    padding: 64px 72px 72px;
    max-width: 66ch;
  }

  h1 {
    margin: 0 0 26px;
    font-family: var(--led-mono);
    font-weight: 500;
    font-size: 30px;
    line-height: 1.32;
    letter-spacing: -0.015em;
    color: var(--led-head);
    text-wrap: pretty;
  }

  /* ===== Rendered markdown ===== */
  .prose :global(p) {
    margin: 0 0 26px;
    font-family: var(--led-sans);
    font-size: 17px;
    line-height: 1.72;
    color: var(--led-body);
  }

  .prose :global(h2) {
    margin: 40px 0 20px;
    font-family: var(--led-mono);
    font-weight: 400;
    font-size: 11px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--led-faint);
  }

  .prose :global(blockquote) {
    margin: 32px 0;
    padding-left: 22px;
    border-left: 2px solid var(--led-quote-rule);
    font-style: italic;
    color: var(--led-quote);
  }

  .prose :global(blockquote p) {
    margin: 0;
    font-size: 17px;
    line-height: 1.66;
    color: inherit;
  }

  .prose :global(ul),
  .prose :global(ol) {
    margin: 0 0 26px;
    padding-left: 20px;
  }

  .prose :global(li) {
    margin-bottom: 12px;
    font-family: var(--led-sans);
    font-size: 17px;
    line-height: 1.72;
    color: var(--led-body);
  }

  .prose :global(li::marker) {
    color: var(--led-faint);
  }

  .prose :global(a) {
    color: var(--led-bright);
    text-underline-offset: 3px;
  }

  .prose :global(strong) {
    color: var(--led-bright);
    font-weight: 500;
  }

  .prose :global(img) {
    display: block;
    width: 100%;
    height: auto;
    margin: 32px 0;
    border: 1px solid var(--led-rule);
  }

  .prose :global(em) {
    font-style: italic;
  }

  .prose :global(> :last-child) {
    margin-bottom: 0;
  }

  .post-next {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 72px 56px;
    border-top: 1px solid var(--led-rule);
  }

  .next-label {
    font-family: var(--led-mono);
    font-size: 11px;
    letter-spacing: 0.16em;
    color: var(--led-faint);
  }

  .next-title {
    font-family: var(--led-mono);
    font-size: 16px;
    color: var(--led-bright);
    text-decoration: none;
    text-wrap: pretty;
  }

  .next-title:hover {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  @media (max-width: 720px) {
    .post-bar {
      padding: 20px 24px;
      font-size: 11px;
    }

    .post-body {
      padding: 36px 24px 44px;
    }

    h1 {
      font-size: 23px;
      line-height: 1.28;
    }

    .prose :global(p),
    .prose :global(li),
    .prose :global(blockquote p) {
      font-size: 16px;
    }

    .post-next {
      padding: 22px 24px 40px;
    }
  }
</style>
